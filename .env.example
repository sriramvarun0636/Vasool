# Nothing in README's reproduction block reads this file: tests, the demo
# replay, the evaluation, the red team and the shadow replay all run with it
# absent. It is for the two opt-in paths that reach a real service.

# LIVE=1 make demo -- Razorpay's test-mode API.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# A pepper of your own, keying customer ids for payloads a live run touches.
# Required by --live, which refuses to fall back. Not the evaluation's pepper:
# that one is registered and public, in windtunnel/pepper.py.
VASOOL_ID_PEPPER=

# RECORD=1 make shadow -- the model provider behind the LLM comparison.
GEMINI_API_KEY=
