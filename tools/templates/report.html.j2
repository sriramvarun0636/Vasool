{{ redteam_json }}
    </script>
    <script type="application/json" id="holdout-data">
{{ holdout_json }}
    </script>
    <script type="application/json" id="chain-data">
{{ chain_json }}
    </script>
    <script type="application/json" id="model-data">
{{ model_json }}
    </script>

    <nav id="spine" aria-label="Exhibits">
        <!-- Generated by the script from the exhibits present -->
    </nav>

    <div id="content">

        <header class="topbar">
          <div class="bar">
            <a class="lockup" href="#top" aria-label="Vasool, top of the report card">
                {{ logo_svg }}
                <span class="wordmark">Vasool</span>
            </a>
            <nav class="volumes" aria-label="Volumes">
                <a href="#top" aria-current="page">Report card</a>
                <a href="theatre/index.html">Episode theatre</a>
            </nav>
            <span class="spacer"></span>
            <a class="toplink" href="https://github.com/sriramvarun0636/Vasool/blob/main/docs/EVALUATION.md">Protocol</a>
            <a class="toplink" href="https://github.com/sriramvarun0636/Vasool">Source</a>
            <button class="prov-toggle" id="prov-toggle" type="button" aria-pressed="false"
                    title="Show the source behind every figure on this page">
                <span class="prov-dot"></span><span class="pt-label"> trace every number</span>
            </button>
          </div>
        </header>

        <div class="prov-banner">
            <strong>Provenance mode.</strong> Every figure below now shows the exact key it was
            read from &mdash; in <code>out/development/evaluation.json</code>, the manifest
            <code>make sweeps</code> writes, unless it names another artifact. Nothing on this
            page is typed by hand; a value an artifact does not carry renders as a dash rather
            than a plausible number. That rule is not decorative &mdash; a hardcoded constant was
            found masquerading as a measurement in this very file and is recorded in
            <code>EVALUATION.md</code> &sect;10.
        </div>

        <div id="fallback-warning">
            WARNING: evaluation.json parse failed or is incomplete. Figures it does not carry render as a dash, and receipts it does not carry cannot be verified.
        </div>

        <section class="hero" id="top">
            <div class="hero-main">
                <div class="kicker">Agent report card<span class="sep">/</span><span id="hero-cohort">&mdash;</span><span class="sep">/</span><span id="hero-agent">&mdash;</span></div>
                <h1 id="hero-money">&mdash;</h1>
                <p id="hero-sub" class="hero-sub">{{ hero_scope }} &middot;
                   <span id="hero-violations">&mdash;</span></p>
                <p class="dek" id="hero-dek">&mdash;</p>
                <div class="hero-acts">
                    <a class="cta primary" href="theatre/index.html"><span class="glyph">&#9654;</span> Watch one episode</a>
                    <a class="cta" href="#exhibit-a">Read the evidence</a>
                </div>
                <p id="hero-split" class="hero-note">&mdash;</p>
                <p class="hero-note">
                   <span id="hero-trajectories">&mdash;</span> arm-seed runs &middot; <span id="hero-run-split">&mdash;</span>
                </p>
            </div>
            <aside class="glance" aria-label="The record">
                <div class="gh">The record, from the artifacts</div>
                <div id="glance"></div>
                <div class="gfoot" id="glance-foot">&mdash;</div>
            </aside>
        </section>

        <div class="exhibit band-dependent" id="exhibit-a">
            <header class="ex-head">
                <span class="band-tag">&sect;2b &middot; simulator-dependent &mdash; the outcome model decides these</span>
                <h2 class="exhibit-title">EXHIBIT A &mdash; <span class="ex-name">The Money, and What It Cost</span></h2>
            </header>
            <p class="viz-caption">
                The money above is what the agent recovered. This is what it cost to recover it
                compliantly: the realistic incumbent recovers <em>more</em>, and that was registered
                as falsification criterion <strong>F1</strong> before the first run. The interval
                below excludes zero <em>in the baseline's favour</em> &mdash; a worse result than F1
                firing, and the artifact says so in its own <code>detail</code> field. Every figure
                here is read from <code>out/development/evaluation.json</code>; nothing is
                hardcoded, and a value the manifest does not carry renders as a dash.
            </p>

            <div class="versus" id="versus" role="table" aria-label="Three arms compared on recovery and on safety"></div>
            <p class="footnote" id="versus-note"></p>

            <h3 class="sub-h">Paired difference vs Vasool, recovery rate</h3>
            <p class="viz-caption" id="forest-caption">
                Every arm runs the same seeded universe &mdash; same customers, same arrivals, same
                outcome draws &mdash; so the comparison is the per-seed difference, bootstrapped over
                the development cohort's seeds. Bars are 95% percentile intervals.
                <span id="forest-width">&mdash;</span> A marker clear of the dashed zero line is a
                real difference; which side it falls on is the story.
            </p>
            <div class="viz-legend">
                <span><span class="viz-swatch" style="background: var(--viz-ahead);"></span> Vasool recovers more</span>
                <span><span class="viz-swatch" style="background: var(--viz-behind);"></span> Vasool recovers less</span>
                <span><span class="viz-swatch" style="background: var(--viz-zero); border: 1px dashed var(--viz-axis);"></span> zero &mdash; no detectable difference</span>
            </div>
            <div class="plot-card">
                <div class="viz-scroll viz-figure">
                    <svg class="forest" id="forest" role="img"
                         aria-label="Paired difference in recovery rate against Vasool, with 95% bootstrap intervals"></svg>
                </div>
            </div>
            <details class="tv-toggle">
                <summary>Table view</summary>
                <div class="world-scroll">
                <table class="world-table" id="forest-table">
                    <thead><tr><th>Arm</th><th>Difference</th><th>95% interval</th><th>Excludes zero</th></tr></thead>
                    <tbody></tbody>
                </table>
                </div>
            </details>
        </div>

        <div class="exhibit band-independent" id="exhibit-b">
            <header class="ex-head">
                <span class="band-tag">&sect;2a &middot; simulator-independent &mdash; the simulator cannot fake these</span>
                <h2 class="exhibit-title">EXHIBIT B &mdash; <span class="ex-name">The Safety Ledger</span></h2>
            </header>
            <p class="viz-caption">
                These are properties of what the agent <em>did</em>, scanned from the hash-chained
                ledger. They hold or fail regardless of what outcome model runs underneath, which is
                why they are the claims this project actually rests on &mdash; and why they are
                banded differently from every recovery number on this page. Fifteen pure-function
                guards gate the execution plane; all fifteen are evaluated on every proposal and
                resolved by severity, never short-circuited.
            </p>
            <div class="tiles" id="safety-tiles"></div>

            <h3 class="sub-h">The chain, in the order it runs</h3>
            <p class="sub-lede">
                Drawn from <code>vasool/policy/registry.py</code> at build time, not copied: each
                link is a guard's own <code>name</code> and <code>statute</code>, in evaluation
                order, with COMPLIANCE.md's number beside it. Where the code sets no statute &mdash;
                a platform constraint or a house rule &mdash; the page says <code>None</code> rather
                than lending it one.
            </p>
            <ol class="chain" id="chain" aria-label="The guard chain, in evaluation order"></ol>
            <p class="footnote" id="chain-note"></p>

            <h3 class="sub-h">World-keyed counters</h3>
            <p class="sub-lede">
                Counted against the class the <em>world</em> registered for each episode, not
                the label the arm assigned itself &mdash; so an arm that declines to classify
                cannot satisfy these by mislabelling. <strong>These are world numbers, not
                ledger scans, and they are not part of EVALUATION.md &sect;2a.</strong>
                Every row is the sum over the development cohort.
            </p>
            <div class="world-scroll">
            <table class="world-table" id="world-table">
                <thead>
                    <tr>
                        <th>Arm</th>
                        <th>Retries on<small>INSTRUMENT_DEAD</small></th>
                        <th>Actions on<small>RISK_BLOCK</small></th>
                        <th>Retries on<small>CUSTOMER_ACTION</small></th>
                    </tr>
                </thead>
                <tbody><!-- Generated by the script --></tbody>
            </table>
            </div>
            <p class="footnote">
                <strong>The first column is read across arms, not against zero.</strong> Taxonomy
                &sect;2 permits one probe on an <code>INSTRUMENT_DEAD</code> row, so a non-zero count
                is expected of an agent that classifies honestly; the other two columns price at
                zero and are coloured by it. The third closes the limit registered in
                EVALUATION.md &sect;10 on 2026-08-24, which recorded that <code>CUSTOMER_ACTION</code>
                &mdash; 0.09 of the registered failure mix, and priced at zero retry budget &mdash;
                had no world-keyed counter, so a baseline retrying those episodes earned recovery
                credit with no guardrail reporting it. A dash means the artifact does not carry the
                field; no value here is defaulted.
            </p>

            <h3 class="sub-h">Where every episode ended</h3>
            <p class="sub-lede">
                A recovery rate reports one bucket and leaves the rest as a single
                undifferentiated failure. <strong>Restraint is not a failure, and neither is an
                episode the horizon cut short.</strong> The four terminal states are absorbing,
                so this is a partition: every episode appears exactly once, and the row sums to
                the episode count. <code>blocked</code> is the agent declining to act;
                <code>escalated</code> is a human taking it; <code>awaiting</code> is
                <em>right-censored</em> &mdash; still in flight when the horizon ended, neither
                won nor lost.
            </p>
            <div class="viz-legend" style="margin-top: 24px;">
                <span><span class="viz-swatch" style="background: var(--part-recovered);"></span> recovered</span>
                <span><span class="viz-swatch" style="background: var(--part-blocked);"></span> blocked</span>
                <span><span class="viz-swatch" style="background: var(--part-escalated);"></span> escalated</span>
                <span><span class="viz-swatch" style="background: var(--part-exhausted);"></span> exhausted</span>
                <span><span class="viz-swatch" style="background: var(--part-awaiting); border: 1px solid var(--hairline-firm);"></span> awaiting</span>
            </div>
            <div class="pbars" id="pbars" role="img" aria-label="Each arm's episodes partitioned into five terminal buckets"></div>
            <div class="world-scroll">
            <table class="world-table" id="closure-table" style="margin-top: 36px;">
                <thead>
                    <tr>
                        <th>Arm</th>
                        <th>Episodes</th>
                        <th>Recovered</th>
                        <th>Blocked<small>declined by policy</small></th>
                        <th>Escalated<small>to a human</small></th>
                        <th>Exhausted<small>budget burned</small></th>
                        <th>Awaiting<small>censored</small></th>
                    </tr>
                </thead>
                <tbody><!-- Generated by the script --></tbody>
            </table>
            </div>
            <p class="viz-caption" id="closure-note" style="margin-top: 20px; margin-bottom: 0;"></p>
        </div>

        <div class="exhibit band-dependent" id="exhibit-c">
            <header class="ex-head">
                <span class="band-tag">&sect;7 &middot; sensitivity</span>
                <h2 class="exhibit-title">EXHIBIT C &mdash; <span class="ex-name">Does It Survive the Sweep?</span></h2>
            </header>
            <p class="viz-caption">
                <span id="guess-lede">Most of the outcome parameters are guesses.</span> So every registered parameter is
                swept independently at &minus;50%, &minus;25%, +25% and +50% of its value, 9 arms at a
                time, and each comparison is re-tested in every configuration. A cell is marked only
                when the comparison <em>fails to survive</em>; the unremarkable majority stays
                recessive, because the exceptions are the finding. <strong>F6 fires if 5 or more of
                the 8 comparisons flip in at least one configuration.</strong>
            </p>
            <div id="sweep-present">
                <div class="viz-legend">
                    <span><span class="viz-swatch" style="background: rgba(255,255,255,0.09);"></span> survives</span>
                    <span><span class="viz-swatch" style="background: var(--viz-behind);"></span> fails to survive</span>
                    <span style="color: var(--viz-muted);">each column is one configuration</span>
                </div>
                <div class="plot-card">
                    <div class="viz-scroll viz-figure">
                        <div class="grid-wrap" id="sweep-grid" style="min-width: 620px;"></div>
                    </div>
                </div>
                <p class="viz-caption" id="sweep-note" style="margin-top: 22px; margin-bottom: 0;"></p>
            </div>
            <div class="empty-state" id="sweep-absent" hidden>
                <div class="es-t">Not in this manifest</div>
                <div class="es-b" id="sweep-absent-body"></div>
            </div>
        </div>

        <div class="exhibit band-dependent" id="exhibit-d">
            <header class="ex-head">
                <span class="band-tag">&sect;9 &middot; registered in advance</span>
                <h2 class="exhibit-title">EXHIBIT D &mdash; <span class="ex-name">What Would Have Killed This</span></h2>
            </header>
            <p class="viz-caption">
                Seven criteria, each with a threshold, written into the protocol before any run
                existed. A criterion invented after seeing the numbers is not a criterion.
                <span id="f-summary">&mdash;</span> Read F1's row carefully, because
                <code>fired: false</code> is not the same as good news, and the artifact says so in
                its own <code>detail</code> field.
            </p>
            <div class="fboard" id="fboard"></div>
        </div>

        <div class="exhibit band-independent" id="exhibit-e">
            <header class="ex-head">
                <span class="band-tag">&sect;4.5 &middot; where the LLM lost</span>
                <h2 class="exhibit-title">EXHIBIT E &mdash; <span class="ex-name">Should the LLM Own This?</span></h2>
            </header>
            <p class="viz-caption">
                The architecture keeps the LLM away from money. That is a claim; this is the
                measurement behind it. Both classifiers were asked the same questions in shadow
                &mdash; the LLM never touched a ledger, and a test walks the import graph in both
                directions to prove it could not have.
                <strong>The rules column is 1.000 by construction, not by measurement</strong>
                &mdash; ground truth resolves through the same lookup the rules read, and saying
                so is the only way the other column means anything.
                <span id="llm-scope"></span>
            </p>
            <div class="tiles" id="llm-tiles"></div>
            <div class="viz-scroll">
            <table class="world-table" id="llm-table" style="margin-top: 40px;">
                <thead>
                    <tr>
                        <th>Failure the webhook reported</th>
                        <th>Truth</th>
                        <th>Rules</th>
                        <th>LLM</th>
                        <th>Accuracy</th>
                        <th>Consistency</th>
                        <th>Episodes</th>
                    </tr>
                </thead>
                <tbody><!-- Generated by the script --></tbody>
            </table>
            </div>
            <p class="viz-caption" id="llm-note" style="margin-top: 22px; margin-bottom: 0;"></p>
        </div>

        <div class="exhibit" id="exhibit-f">
            <header class="ex-head">
                <span class="band-tag">invariant 1 &middot; proved by parsing, drawn here</span>
                <h2 class="exhibit-title">EXHIBIT F &mdash; <span class="ex-name">The AI Air-Gap</span></h2>
            </header>
            <p class="viz-caption">
                Not a drawing of the claim &mdash; the claim itself.
                <code>tests/test_shadow_boundary.py</code> proves invariant 1 by walking the
                import graph with <code>ast</code>; this is that same graph, parsed at build
                time and rendered. Arrows run from importer to imported, so both planes point
                <em>into</em> the shared vocabulary: they agree on the type definitions and
                share no path.
            </p>
            <div class="airgap-card">
            {{ airgap_svg }}
            </div>
            <p class="viz-caption" style="margin-top: 26px; margin-bottom: 0;">
                <strong>The two planes share types, not paths.</strong> That is why the gap holds
                without a filter in it: the LLM emits an <code>LLMVerdict</code>, the policy plane
                consumes a <code>Proposal</code>, and no function in the repository converts one
                into the other. For the model to move money someone would have to write a
                conversion that does not exist &mdash; and an absence cannot have a bug in it,
                which a validator can.
                <br><br>
                The only two modules importing the classifier are the shadow harnesses that score
                it, and neither can act. Note what the execution plane&rsquo;s modules include:
                fifteen guards, of which <strong>eleven rest on a statute</strong>. The other four
                &mdash; idempotency, the retry cap, the spend cap, the human handoff &mdash; are
                platform constraints and house rules whose <code>statute</code> attribute is
                <code>None</code>. Calling all fifteen statutory would be the cheapest way to
                make this page look stronger than it is.
            </p>
        </div>

        <div class="exhibit band-independent" id="exhibit-g">
            <header class="ex-head">
                <span class="band-tag">&sect;2a &middot; the adversary</span>
                <h2 class="exhibit-title">EXHIBIT G &mdash; <span class="ex-name">What Still Beats It</span></h2>
            </header>
            <p class="viz-caption">
                The survival criterion was registered <em>before</em> the first attack was written,
                and <code>judge()</code> is the only thing that can return a verdict. It scans the
                ledger the way &sect;2a scans &mdash; never &ldquo;a guard returned BLOCKED&rdquo;.
                An attack may add evidence requirements; it cannot lower the bar. Each row below
                carries the SHA-256 of the ledger that attack produced.
            </p>
            <div class="tiles" id="rt-tiles"></div>
            <div class="viz-scroll">
            <table class="world-table" id="rt-table" style="margin-top: 40px;">
                <thead>
                    <tr><th>Attack</th><th>Verdict</th><th>Why</th><th>Receipts</th><th>Ledger</th></tr>
                </thead>
                <tbody><!-- Generated by the script --></tbody>
            </table>
            </div>
            <p class="viz-caption" id="rt-note" style="margin-top: 22px; margin-bottom: 0;"></p>
        </div>

        <div class="exhibit" id="exhibit-h">
            <header class="ex-head">
                <span class="band-tag">do not trust this page &middot; check it</span>
                <h2 class="exhibit-title">EXHIBIT H &mdash; <span class="ex-name">The Audit Trail</span></h2>
            </header>
            <p class="viz-caption">
                Recompute a receipt's SHA-256 digest here, in your browser, with the Web Crypto API
                &mdash; from the exact bytes the ledger sealed, which Exhibit I shows. Then forge one
                byte and watch the digest stop matching: a receipt cannot be edited after the fact
                without the edit showing.
            </p>
            <div class="verifier-box">
                <div class="input-group">
                    <input type="text" id="verify-input" placeholder="receipt_id, e.g. rcpt_…" value="" aria-label="Receipt id">
                    <button class="btn p" type="button" onclick="runVerification()">Verify record</button>
                    <button class="btn danger" type="button" id="forge-btn" onclick="runVerification(true)">Forge one byte</button>
                </div>
                <div id="verifier-console">&gt; awaiting input...</div>
                <div id="verifier-hex"></div>
            </div>
        </div>

        <div class="exhibit" id="exhibit-i">
            <header class="ex-head">
                <span class="band-tag">one seed's ledger, from genesis</span>
                <h2 class="exhibit-title">EXHIBIT I &mdash; <span class="ex-name">Trajectory Explorer</span></h2>
            </header>
            <p class="viz-caption" id="explorer-caption">
                Real receipts from the head of one seed's ledger, shown as the <em>exact byte
                string</em> each hash was computed over &mdash; guard decisions, obligations, statute
                citations and all. Nothing here is pretty-printed, because reformatting would change
                the bytes and break the hash. Every digest and every link back to genesis is
                recomputed in this browser when the page loads.
            </p>
            <div class="explorer-board">
                <div class="explorer-list" id="explorer-list">
                    <!-- Generated by the script -->
                </div>
                <div class="explorer-console" id="explorer-console">
                    &gt; Select a receipt from the ledger...
                </div>
            </div>
        </div>

        <footer class="page-footer" id="colophon">
            <div>
                <p class="footer-claim">
                    A figure not derivable from the protocol is not a result&nbsp;&mdash; including ours.
                </p>
                <p class="footer-meta">
                    Nine exhibits, rendered from <code>out/development/evaluation.json</code> &mdash;
                    development cohort, <span id="foot-seeds">&mdash;</span> seeds across
                    <span id="foot-arms">&mdash;</span> arms, with the sealed holdout beside it in the
                    hero. Every figure above carries the key it was read from: click
                    <em>trace every number</em> to show all of them at once. A value an artifact does
                    not carry renders as a dash and raises a banner &mdash; never as a plausible
                    number, because one hardcoded constant did render as a measurement here once, and
                    a test now fails the build if a fallback is reintroduced.
                </p>
                <p class="footer-links">
                    <a href="https://github.com/sriramvarun0636/Vasool">Repository</a> &nbsp;&middot;&nbsp;
                    <a href="theatre/index.html">The episode theatre</a> &nbsp;&middot;&nbsp;
                    <a href="https://github.com/sriramvarun0636/Vasool/blob/main/docs/EVALUATION.md">The pre-registered protocol</a> &nbsp;&middot;&nbsp;
                    <a href="https://github.com/sriramvarun0636/Vasool/blob/main/POSTMORTEM.md">Thirteen incidents</a> &nbsp;&middot;&nbsp;
                    <a href="https://github.com/sriramvarun0636/Vasool/blob/main/COMPLIANCE.md">The fifteen guards</a>
                </p>
            </div>
            <div class="colophon-mark">
                {{ logo_svg }}
                <span class="deva" lang="hi">वसूल</span>
                <span class="gloss">vasool &mdash; of money owed: recovered</span>
            </div>
        </footer>

    </div>

    <script>
        // --- DATA LAYER -------------------------------------------------------
        // Five artifacts are embedded above. Each is parsed on its own, so one
        // that is absent or corrupt costs its own exhibit and nothing else.
        let EVAL = {};
        // No literal starting values. These were 49.07, 65.42, 53.81 and
        // 160200, and the last one was on screen in every build: the keys
        // meant to overwrite it never existed in any manifest, so the hero
        // showed a constant as a count (POSTMORTEM.md INC-008). A figure the
        // manifest does not carry is a dash.
        let vasoolYield = null;
        let baselineYield = null;
        let greedyYield = null;
        let baseRuns = null;
        let sweepRuns = 0;
        let totalRuns = null;
        let usingFallback = false;
        // Same rule for the §2a violation count: measured or not shown. It
        // used to be a static string in the markup that no code ever set,
        // which meant "0 safety violations" rendered whatever the artifact said.
        let safetyViolations = null;
        let safetySeeds = null;
        let sampleLedger = [];

        try {
            const raw = document.getElementById("eval-data").textContent;
            EVAL = JSON.parse(raw);
            const arms = EVAL.per_arm || {};

            if (typeof arms.vasool?.recovery_rate_mean === "number") {
                vasoolYield = (arms.vasool.recovery_rate_mean * 100).toFixed(2);
            }
            if (typeof arms.retry_plus_contact?.recovery_rate_mean === "number") {
                baselineYield = (arms.retry_plus_contact.recovery_rate_mean * 100).toFixed(2);
            }
            if (typeof arms.vasool_ungated?.recovery_rate_mean === "number") {
                greedyYield = (arms.vasool_ungated.recovery_rate_mean * 100).toFixed(2);
            }

            // The run count is the manifest's own: every arm's seeds, plus —
            // when the manifest carries §7's grid — its configurations and
            // reference, times the arms, times the grid's seeds.
            const seedsPerArm = Object.values(arms).map(a => a?.seeds).filter(n => typeof n === "number");
            if (seedsPerArm.length) {
                baseRuns = seedsPerArm.reduce((total, n) => total + n, 0);
                const reference = Object.values(EVAL.sweep_reference || {})[0] || {};
                const sweepSeeds = Object.values(reference)[0]?.n_seeds;
                if (EVAL.sweeps && typeof sweepSeeds === "number") {
                    sweepRuns = (Object.keys(EVAL.sweeps).length + 1) * (EVAL.arms || []).length * sweepSeeds;
                }
                totalRuns = baseRuns + sweepRuns;
            } else {
                usingFallback = true;
            }

            sampleLedger = (EVAL.determinism && Array.isArray(EVAL.determinism.sample_receipts))
                ? EVAL.determinism.sample_receipts : [];

            const holds = arms.vasool?.safety_holds_on;
            const seeds = arms.vasool?.seeds;
            if (typeof holds === "number" && typeof seeds === "number") {
                safetyViolations = seeds - holds;
                safetySeeds = seeds;
            } else {
                usingFallback = true;
            }

            if (!EVAL.per_arm) {
                usingFallback = true;
            }
        } catch (e) {
            console.error("JSON parse failure:", e);
            usingFallback = true;
        }

        const readArtifact = (id) => {
            try {
                return JSON.parse(document.getElementById(id).textContent) || {};
            } catch (e) {
                return {};
            }
        };
        const SHADOW = readArtifact("shadow-data");
        const RT = readArtifact("redteam-data");
        const HOLDOUT = readArtifact("holdout-data");
        // The guard chain, as vasool/policy/registry.py defines it, serialised
        // by tools/report.py at build time. It used to be a hand-written list
        // in this file -- the kind of copy INC-008 was about.
        const CHAIN = readArtifact("chain-data");
        const MODEL = readArtifact("model-data");

        // --- CRYPTO HELPER ------------------------------------------------------
        async function hashString(str) {
            if (!window.crypto || !window.crypto.subtle) {
                return "insecure-env";
            }
            try {
                const data = new TextEncoder().encode(str);
                const digest = await crypto.subtle.digest("SHA-256", data);
                return Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, "0")).join("");
            } catch (e) {
                return "hash-error";
            }
        }

        function escapeHtml(unsafe) {
            return String(unsafe)
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        }

        // `mk("b.behind")` is an element with a class. It takes one argument so
        // that it can sit inside a trace call without a comma, which is what
        // lets tests/test_report.py read every literal path on this page.
        function mk(spec) {
            const [tag, ...classes] = spec.split(".");
            const node = document.createElement(tag);
            if (classes.length) node.className = classes.join(" ");
            return node;
        }
        function words(n) {
            const w = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
                       "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen",
                       "eighteen", "nineteen", "twenty"];
            return (n >= 0 && n < w.length) ? w[n] : new Intl.NumberFormat().format(n);
        }
        const nf = (n) => new Intl.NumberFormat().format(n);
        const pct = (x) => (x * 100).toFixed(2) + "%";
        const pp = (x) => (x * 100).toFixed(2) + "pp";

        // --- RENDER LAYER ---------------------------------------------------------
        document.addEventListener("DOMContentLoaded", async () => {

            if (usingFallback) {
                document.getElementById("fallback-warning").style.display = "block";
            }

            // 1. Provenance. `trace` is the only way a figure from the manifest
            // gets onto this page: it stamps the element with the key it came
            // from and appends the path node the toggle reveals. If a number
            // reaches the DOM without going through here, it has no source —
            // which is the bug class this whole feature exists to make visible.
            // `traceIn` is the same for the four other artifacts, and names the
            // file as well as the key.
            const traced = [];
            function trace(el, path, text) {
                if (!el) return el;
                if (text !== undefined) el.textContent = text;
                el.setAttribute("data-src", path);
                const tag = document.createElement("div");
                tag.className = "prov-path";
                tag.textContent = path;
                el.appendChild(tag);
                traced.push(path);
                return el;
            }
            const ARTIFACTS = {
                holdout: "out/holdout/evaluation.json",
                redteam: "out/adversary/redteam.json",
                shadow: "out/shadow/classifier_comparison.json",
                chain: "vasool/policy/registry.py (GUARD_CHAIN)",
                model: "windtunnel/parameters.py (OUTCOME_PARAMETERS)"
            };
            function traceIn(artifact, el, path, text) {
                if (!el) return el;
                if (text !== undefined) el.textContent = text;
                const where = `${ARTIFACTS[artifact]} › ${path}`;
                el.setAttribute("data-src", where);
                const tag = document.createElement("div");
                tag.className = "prov-path";
                tag.textContent = where;
                el.appendChild(tag);
                traced.push(where);
                return el;
            }
            // A sentence made of prose and traced figures, without string-
            // building HTML around the figures.
            function compose(el, parts) {
                if (!el) return;
                el.textContent = "";
                parts.forEach(p => {
                    if (p === null || p === undefined) return;
                    if (typeof p === "string") el.insertAdjacentHTML("beforeend", p);
                    else el.appendChild(p);
                });
            }

            const provBtn = document.getElementById("prov-toggle");
            if (provBtn) {
                provBtn.addEventListener("click", () => {
                    const on = document.body.classList.toggle("provenance");
                    provBtn.setAttribute("aria-pressed", String(on));
                    provBtn.lastChild.textContent = on
                        ? ` ${traced.length} figures traced`
                        : " trace every number";
                });
            }

            const arms = EVAL?.per_arm || {};
            const ARM_LABELS = {
                vasool: "Vasool",
                naive_retry: "naive_retry",
                retry_plus_contact: "retry_plus_contact",
                vasool_ungated: "vasool_ungated"
            };
            const armOrder = Object.keys(ARM_LABELS).filter(a => a in arms)
                .concat(Object.keys(arms).filter(a => !(a in ARM_LABELS)));

            // 2. The hero. Money first: the run count is effort; this is the
            // result, and it is what a recovery agent exists to produce.
            const crore = (paise) => "₹" + (paise / 100 / 1e7).toFixed(2) + " Cr";
            // Which holdout this is, from the artifact rather than from prose.
            // The date it ran is in no field of the file, so saying one would
            // be a claim this page cannot support — the same defect INC-011
            // records. The seed range is in `seeds`, and it is what
            // distinguishes the sealed 60% from §10's fresh range.
            const holdoutRange = () => {
                const s = HOLDOUT?.seeds;
                if (typeof s?.first !== "number" || typeof s?.last !== "number") {
                    return "a seed range this artifact does not state";
                }
                return `seeds ${s.first}\u2013${s.last}`;
            };
            const devPaise = EVAL?.per_arm?.vasool?.recovered_paise_total;
            const holdPaise = HOLDOUT?.per_arm?.vasool?.recovered_paise_total;
            const heroMoney = document.getElementById("hero-money");
            const heroSplit = document.getElementById("hero-split");
            // Two cohorts are added only when one agent produced both.
            // There are two holdouts on disk now — the sealed 60% of seeds
            // 0..999, and the fresh range 1000..1999 registered on 2026-09-20
            // — and tools/report.py hands this page the newer one. Either way
            // the rule is the same: a sum across two agents is a number
            // neither produced, so the fingerprints have to match.
            const sameAgent = typeof HOLDOUT?.agent_fingerprint === "string"
                && HOLDOUT.agent_fingerprint === EVAL?.agent_fingerprint;

            if (heroMoney) {
                if (typeof devPaise !== "number") {
                    heroMoney.innerText = "—";
                } else if (typeof holdPaise === "number" && sameAgent) {
                    trace(heroMoney,
                          "per_arm.vasool.recovered_paise_total (development + holdout)",
                          crore(devPaise + holdPaise));
                } else {
                    trace(heroMoney, "per_arm.vasool.recovered_paise_total", crore(devPaise));
                }
            }
            if (heroSplit) {
                if (typeof devPaise !== "number") {
                    heroSplit.innerHTML = "&mdash;";
                } else if (typeof holdPaise !== "number") {
                    heroSplit.innerHTML = `development cohort only &mdash; the holdout has not been evaluated`;
                } else if (sameAgent) {
                    compose(heroSplit, [
                        traceIn("holdout", mk("b"), "per_arm.vasool.recovered_paise_total", crore(holdPaise)),
                        ` more in the holdout (the sealed 60%, evaluated once), added because one agent `,
                        `produced both &middot; every other figure on this page is the development cohort`
                    ]);
                } else {
                    compose(heroSplit, [
                        `Development cohort, 40% of customers. The holdout &mdash; `,
                        traceIn("holdout", mk("b"), "per_arm.vasool.recovered_paise_total", crore(holdPaise)),
                        `, evaluated once on ${holdoutRange()} &mdash; describes an earlier agent and `,
                        `is not added: a sum across two agents is a number neither produced.`
                    ]);
                }
            }

            const heroCohort = document.getElementById("hero-cohort");
            if (heroCohort && typeof EVAL.cohort === "string") {
                trace(heroCohort, "cohort", `${EVAL.cohort} cohort`);
            }
            const heroAgent = document.getElementById("hero-agent");
            if (heroAgent && typeof EVAL.agent_fingerprint === "string") {
                trace(heroAgent, "agent_fingerprint", `agent ${EVAL.agent_fingerprint.slice(0, 8)}`);
            }

            const heroViolations = document.getElementById("hero-violations");
            if (safetyViolations === null) {
                heroViolations.innerText = "safety violations: unavailable (no measurement in artifact)";
            } else {
                trace(heroViolations, "per_arm.vasool.seeds − per_arm.vasool.safety_holds_on",
                      `${nf(safetyViolations)} safety violations in ${nf(safetySeeds)} seeds`);
            }

            // The dek states the trade in the manifest's own terms, and in
            // either direction: if a re-run ever flips the gap, the sentence
            // flips with it rather than going on saying what used to be true.
            const dek = document.getElementById("hero-dek");
            const gap = EVAL?.paired_vs_vasool?.retry_plus_contact?.recovery_rate;
            const inc = arms.retry_plus_contact;
            // §9, registered before the first run: if F6 fires, "the evaluation
            // does not support conclusions and is presented as an
            // instrument-building exercise instead". This is that presentation.
            // It is keyed on the artifact's own verdict, so the sentence under
            // the headline changes when the verdict does and at no other time,
            // and what it keeps is only what §2a says no outcome model can move.
            const f6 = EVAL?.falsification?.F6_conclusions_are_model_artifacts;
            const vas = arms.vasool;
            if (dek && f6?.fired === true && Array.isArray(f6.denominator)
                    && typeof f6.flipped_count === "number" && typeof vas?.safety_holds_on === "number") {
                compose(dek, [
                    trace(mk("b.behind"), "falsification.F6_conclusions_are_model_artifacts.fired", "F6 fired."),
                    " ",
                    trace(mk("b"), "falsification.F6_conclusions_are_model_artifacts.flipped_count",
                          `${f6.flipped_count} of ${f6.denominator.length}`),
                    " recovery comparisons fail to survive a \u00b150% move of the outcome model, so under ",
                    "the rule registered before the first run, the recovery figures on this page are what ",
                    "this simulator produced \u2014 not findings. What the simulator cannot move still holds: ",
                    "the safety predicate on ",
                    trace(mk("b"), "per_arm.vasool.safety_holds_on",
                          `${nf(vas.safety_holds_on)} of ${nf(vas.seeds)}`),
                    " seeds."
                ]);
            } else if (dek && typeof gap?.point === "number" && typeof inc?.safety_holds_on === "number") {
                const broke = inc.seeds - inc.safety_holds_on;
                const lead = gap.point < 0
                    ? ["The incumbent it is measured against recovers ",
                       trace(mk("b.behind"), "paired_vs_vasool.retry_plus_contact.recovery_rate.point",
                             `${Math.abs(gap.point * 100).toFixed(2)} points more`)]
                    : ["Vasool recovers ",
                       trace(mk("b"), "paired_vs_vasool.retry_plus_contact.recovery_rate.point",
                             `${(gap.point * 100).toFixed(2)} points more`),
                       " than the incumbent it is measured against"];
                const tail = broke > 0
                    ? [" — and breaks the safety predicate on ",
                       trace(mk("b"), "per_arm.retry_plus_contact.safety_holds_on",
                             `${nf(broke)} of ${nf(inc.seeds)}`),
                       " seeds. That gap is what compliance cost in this simulator, measured ",
                       "against a protocol registered before the first run."]
                    : [", and keeps the safety predicate on every seed."];
                compose(dek, [...lead, ...tail]);
            } else if (dek) {
                dek.innerHTML = "The paired comparison against the incumbent is not in this manifest.";
            }

            // No counting animation. A figure caught mid-count is a figure no
            // artifact produced, and screenshots catch it.
            const heroRuns = document.getElementById("hero-trajectories");
            const heroRunSplit = document.getElementById("hero-run-split");
            if (heroRunSplit && baseRuns !== null) {
                heroRunSplit.innerText = sweepRuns
                    ? `${nf(baseRuns)} base + ${nf(sweepRuns)} sweep`
                    : `${nf(baseRuns)} base · this manifest carries no sweep grid`;
            }
            if (heroRuns) heroRuns.innerText = totalRuns === null ? "—" : nf(totalRuns);

            // The glance. Six verdicts, each from an artifact.
            const glance = document.getElementById("glance");
            const fal = EVAL?.falsification || {};
            const glanceRows = [];
            const va = arms.vasool;
            if (va) {
                const ok = va.safety_holds_on === va.seeds;
                glanceRows.push(["§2a safety predicate",
                    trace(mk("span"), "per_arm.vasool.safety_holds_on", `${nf(va.safety_holds_on)} / ${nf(va.seeds)}`),
                    [`<span class="${ok ? "ok" : "bad"}">${ok ? "✓" : "✗"}</span> seeds on which every §2a claim held`]]);
            }
            if (EVAL?.pass_k && EVAL.pass_k["100"] !== undefined) {
                glanceRows.push(["pass^100",
                    trace(mk("span"), "pass_k.100", Number(EVAL.pass_k["100"]).toFixed(2)),
                    ["a hundred independent worlds, every one clean"]]);
            }
            if (typeof RT.attacks === "number") {
                glanceRows.push(["Red team",
                    traceIn("redteam", mk("span"), "survived", `${RT.survived} / ${RT.attacks}`),
                    ["attacks survive the registered criterion · ",
                     traceIn("redteam", mk("span.warn"), "failed", `${RT.failed} open`),
                     ", each named"]]);
            }
            const fKeys = Object.keys(fal);
            if (fKeys.length) {
                const fired = fKeys.filter(k => fal[k]?.fired === true).length;
                const idle = fKeys.filter(k => fal[k]?.fired !== true && fal[k]?.fired !== false)
                    .map(k => k.split("_")[0]);
                glanceRows.push(["Registered criteria",
                    trace(mk("span"), "falsification", `${fired} fired`),
                    [`of ${fKeys.length - idle.length} evaluated`,
                     idle.length ? ` · <span class="warn">${idle.join(", ")} not evaluated here</span>` : ""]]);
            }
            // §4 requires the guess fraction "in the report card as prominently as
            // the recovery rate". Read from the parameters' own tags, not typed.
            if (typeof MODEL?.guessed === "number" && typeof MODEL?.total === "number") {
                glanceRows.push(["Outcome model",
                    traceIn("model", mk("span"), "guessed", `${MODEL.guessed} / ${MODEL.total}`),
                    ["parameters are guesses, tagged <code>[guess]</code> in the simulator's source"]]);
            }
            if (EVAL?.determinism) {
                const det = EVAL.determinism;
                glanceRows.push(["Determinism",
                    trace(mk("span"), "determinism.identical", det.identical ? "identical" : "MISMATCH"),
                    [`re-run ledgers, byte for byte, on seeds ${(det.seeds_checked || []).join(", ")}`]]);
            }
            if (typeof CHAIN.count === "number") {
                glanceRows.push(["Guard chain",
                    traceIn("chain", mk("span"), "count", String(CHAIN.count)),
                    ["guards rule on every proposal · ",
                     traceIn("chain", mk("span"), "statutes", String(CHAIN.statutes)),
                     " cite a statute"]]);
            }
            glanceRows.forEach(([label, value, sub]) => {
                const row = mk("div.grow");
                const l = mk("div.gl"); l.textContent = label;
                const v = mk("div.gv"); v.appendChild(value);
                const s = mk("div.gs"); compose(s, sub);
                row.append(l, v, s);
                glance.appendChild(row);
            });
            const guessLede = document.getElementById("guess-lede");
            if (guessLede && typeof MODEL?.guessed === "number" && typeof MODEL?.total === "number") {
                const lead = words(MODEL.guessed);
                compose(guessLede, [
                    traceIn("model", mk("span"), "guessed",
                            `${lead.charAt(0).toUpperCase()}${lead.slice(1)} of the ${words(MODEL.total)}`),
                    " outcome parameters are guesses."
                ]);
            }
            const glanceFoot = document.getElementById("glance-foot");
            if (glanceFoot && typeof EVAL.agent_fingerprint === "string") {
                compose(glanceFoot, [
                    "agent fingerprint ",
                    trace(mk("b"), "agent_fingerprint", EVAL.agent_fingerprint.slice(0, 24) + "…"),
                    "<br>every figure on this page names its source &mdash; press <em>trace every number</em>"
                ]);
            }

            // 3. Exhibit A. The three arms as one statement: a column each, a
            // line per measure, every figure straight off the artifact.
            const versus = document.getElementById("versus");
            const COLS = [
                ["retry_plus_contact", "The incumbent", "baseline"],
                ["vasool_ungated", "Vasool, guards removed", "greedy"],
                ["vasool", "The agent", "vasool"]
            ];
            const rates = COLS.map(([a]) => arms[a]?.recovery_rate_mean).filter(r => typeof r === "number");
            const topRate = rates.length ? Math.max(...rates) : 0;
            const put = (spec, arm) => {
                const d = mk(arm === "vasool" ? `${spec}.is-vasool` : spec);
                versus.appendChild(d);
                return d;
            };
            const label = (text, extra) => {
                const d = mk(extra ? `div.vl.${extra}` : "div.vl");
                d.textContent = text;
                versus.appendChild(d);
            };
            label("", "head");
            COLS.forEach(([arm, role]) => {
                put("div.vh", arm).innerHTML = `<div class="role">${role}</div><div class="arm">${arm}</div>`;
            });
            label("Mean recovery rate");
            COLS.forEach(([arm, , slot]) => {
                const c = put("div.rate", arm);
                c.innerHTML = `<div class="yield-number${arm === "vasool" ? " yield-blue" : ""}" id="yield-${slot}">—</div>` +
                              `<div class="arm-bar"><i id="bar-${slot}"></i></div>`;
                const r = arms[arm]?.recovery_rate_mean;
                if (typeof r === "number" && topRate > 0) {
                    c.querySelector("i").style.width = `${(r / topRate) * 100}%`;
                }
            });
            label("§2a safety predicate held");
            COLS.forEach(([arm]) => {
                const m = arms[arm];
                const c = put("div.vc", arm);
                if (!m || typeof m.safety_holds_on !== "number") { c.textContent = "—"; return; }
                const ok = m.safety_holds_on === m.seeds;
                c.appendChild(trace(mk(`span.verdict.${ok ? "ok" : "bad"}`), `per_arm.${arm}.safety_holds_on`,
                    `${ok ? "✓" : "✗"} ${nf(m.safety_holds_on)} / ${nf(m.seeds)}`));
            });
            [
                ["Retries on a dead instrument", "instrument_dead_retries_world", false],
                ["Actions on risk-declined episodes", "risk_block_actions_world", true],
                ["Retries on a zero-budget class", "customer_action_retries_world", true]
            ].forEach(([text, key, pricedAtZero]) => {
                label(text);
                COLS.forEach(([arm]) => {
                    const v = arms[arm]?.[key];
                    const c = put("div.vc", arm);
                    if (typeof v !== "number") { c.textContent = "—"; return; }
                    if (pricedAtZero) c.classList.add(v === 0 ? "zero" : "hot");
                    trace(c, `per_arm.${arm}.${key}`, nf(v));
                });
            });
            compose(document.getElementById("versus-note"), [
                "A tick means §2a's eight claims held on every seed. Retries on a dead instrument include ",
                "the one probe taxonomy §2 permits, so that line is compared across arms rather than against ",
                "zero; the two below it are priced at zero, and coloured by whether they reached it."
            ]);
            trace(document.getElementById("yield-vasool"),
                  "per_arm.vasool.recovery_rate_mean", vasoolYield === null ? "—" : vasoolYield + "%");
            trace(document.getElementById("yield-baseline"),
                  "per_arm.retry_plus_contact.recovery_rate_mean", baselineYield === null ? "—" : baselineYield + "%");
            trace(document.getElementById("yield-greedy"),
                  "per_arm.vasool_ungated.recovery_rate_mean", greedyYield === null ? "—" : greedyYield + "%");

            // Forest plot — paired difference vs Vasool, 95% bootstrap intervals.
            const paired = EVAL?.paired_vs_vasool || {};
            const forestRows = Object.entries(paired)
                .map(([arm, m]) => ({ arm, ...(m.recovery_rate || {}) }))
                .filter(r => typeof r.point === "number")
                .sort((a, b) => a.point - b.point);

            const svg = document.getElementById("forest");
            const MARKER_R = 5.5;
            if (svg && forestRows.length) {
                const NS = "http://www.w3.org/2000/svg";
                const rowH = 46, padT = 34, padB = 46, padL = 168, padR = 96;
                const W = 900, H = padT + forestRows.length * rowH + padB;
                svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
                svg.setAttribute("height", H);
                const lo = Math.min(...forestRows.map(r => r.low), 0);
                const hi = Math.max(...forestRows.map(r => r.high), 0);
                const span = (hi - lo) || 1, pad = span * 0.12;
                const x0 = lo - pad, x1 = hi + pad;
                const X = (v) => padL + ((v - x0) / (x1 - x0)) * (W - padL - padR);
                const el = (n, a, parent) => {
                    const e = document.createElementNS(NS, n);
                    for (const k in a) e.setAttribute(k, a[k]);
                    (parent || svg).appendChild(e);
                    return e;
                };

                // Axis ticks on round percentage-point values, recessive. An
                // axis labelled -21pp / -12pp / -4pp is arithmetic showing
                // through; a reader wants -20 / -10 / 0 / 10 / 20.
                const niceStep = (raw) => {
                    const mag = Math.pow(10, Math.floor(Math.log10(raw)));
                    const n = raw / mag;
                    return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10) * mag;
                };
                const stepPP = niceStep(((x1 - x0) * 100) / 5);
                const startPP = Math.ceil((x0 * 100) / stepPP) * stepPP;
                for (let vpp = startPP; vpp <= x1 * 100 + 1e-9; vpp += stepPP) {
                    const v = vpp / 100;
                    el("line", { x1: X(v), x2: X(v), y1: padT - 10, y2: H - padB + 6, class: "f-grid" });
                    const tk = el("text", { x: X(v), y: H - padB + 24, "text-anchor": "middle", class: "f-tick" });
                    tk.textContent = (vpp > 0 ? "+" : "") + vpp.toFixed(0) + "pp";
                }
                el("line", { x1: X(0), x2: X(0), y1: padT - 10, y2: H - padB + 6, class: "f-zero" });

                forestRows.forEach((r, i) => {
                    const y = padT + i * rowH + rowH / 2;
                    const behind = r.point < 0;
                    const colour = behind ? "var(--viz-behind)" : "var(--viz-ahead)";

                    el("rect", { x: 0, y: y - rowH / 2, width: W, height: rowH, class: "f-row-hit" })
                        .appendChild(document.createElementNS(NS, "title"))
                        .textContent =
                            `${r.arm}\n${(r.point * 100).toFixed(3)}pp ` +
                            `[${(r.low * 100).toFixed(3)}, ${(r.high * 100).toFixed(3)}]\n` +
                            (behind ? "Vasool recovers less" : "Vasool recovers more");
                    el("rect", { x: 0, y: y - rowH / 2, width: W, height: rowH, class: "f-row-bg" });

                    const label = el("text", { x: padL - 18, y: y + 1, "text-anchor": "end", class: "f-label" });
                    label.textContent = r.arm;
                    const sub = el("text", { x: padL - 18, y: y + 15, "text-anchor": "end", class: "f-sub" });
                    sub.textContent = r.excludes_zero ? "excludes zero" : "includes zero";

                    // 2px CI line, rounded ends, a >=8px point marker with a 2px
                    // surface ring so an overlap with the zero rule reads.
                    el("line", {
                        x1: X(r.low), x2: X(r.high), y1: y, y2: y,
                        stroke: colour, class: "f-ci"
                    });
                    el("circle", {
                        cx: X(r.point), cy: y, r: MARKER_R, fill: colour,
                        stroke: "var(--panel)", "stroke-width": 2
                    });

                    const val = el("text", {
                        x: W - padR + 14, y: y + 4, "text-anchor": "start",
                        class: "f-value", fill: colour
                    });
                    val.textContent = (r.point >= 0 ? "+" : "") + (r.point * 100).toFixed(2) + "pp";
                });

                const lhs = el("text", { x: X(0) - 12, y: 16, "text-anchor": "end", class: "f-sub" });
                lhs.textContent = "← Vasool recovers less";
                const rhs = el("text", { x: X(0) + 12, y: 16, "text-anchor": "start", class: "f-sub" });
                rhs.textContent = "Vasool recovers more →";

                // The caption used to say "the widest spans 0.37pp" in type. It
                // is measured here instead, and so is whether every interval
                // really is narrower than the marker drawn over it.
                const widest = forestRows.reduce((a, b) => (b.high - b.low > a.high - a.low ? b : a));
                const underMarker = forestRows.every(r => X(r.high) - X(r.low) < 2 * MARKER_R);
                compose(document.getElementById("forest-width"), underMarker
                    ? ["<strong>At this sample size every interval is narrower than its own marker</strong> &mdash; the widest, ",
                       widest.arm, "'s, spans ",
                       trace(mk("b"), `paired_vs_vasool.${widest.arm}.recovery_rate`, pp(widest.high - widest.low)),
                       " &mdash; so the dots are the intervals, not a plot that forgot to draw them. Exact bounds are in the table view."]
                    : ["The widest interval, ", widest.arm, "'s, spans ",
                       trace(mk("b"), `paired_vs_vasool.${widest.arm}.recovery_rate`, pp(widest.high - widest.low)),
                       "; exact bounds are in the table view."]);

                const tb = document.querySelector("#forest-table tbody");
                forestRows.forEach(r => {
                    const tr = document.createElement("tr");
                    tr.innerHTML =
                        `<td>${r.arm}</td>` +
                        `<td class="${r.point < 0 ? "nonzero" : ""}">${(r.point >= 0 ? "+" : "") + (r.point * 100).toFixed(3)}pp</td>` +
                        `<td>[${(r.low * 100).toFixed(3)}, ${(r.high * 100).toFixed(3)}]</td>` +
                        `<td>${r.excludes_zero ? "yes" : "no"}</td>`;
                    tb.appendChild(tr);
                });
            }

            // 4. Exhibit B. §2a stat tiles.
            const tiles = document.getElementById("safety-tiles");
            if (tiles) {
                const v = arms.vasool;
                const pk = EVAL?.pass_k || {};
                const det = EVAL?.determinism;
                const items = [
                    [v ? `${nf(v.safety_holds_on)} / ${nf(v.seeds)}` : "—",
                     "seeds where all eight §2a claims held",
                     "per_arm.vasool.safety_holds_on"],
                    [pk["100"] !== undefined ? Number(pk["100"]).toFixed(2) : "—",
                     "pass^100 — every one of 100 independent worlds clean",
                     "pass_k.100"],
                    [v ? nf(v.risk_block_actions_world) : "—",
                     "automated actions on risk-declined episodes",
                     "per_arm.vasool.risk_block_actions_world"],
                    [det ? (det.identical ? "identical" : "MISMATCH") : "—",
                     "re-run ledgers, byte-for-byte (F7)",
                     "determinism.identical"]
                ];
                items.forEach(([val, lab, src]) => {
                    const d = document.createElement("div");
                    d.className = "tile";
                    d.innerHTML = `<div class="tv"></div><div class="tl">${lab}</div>`;
                    trace(d.querySelector(".tv"), src, val);
                    tiles.appendChild(d);
                });
            }

            // The chain, in evaluation order, from the registry itself.
            const chainList = document.getElementById("chain");
            const chainNote = document.getElementById("chain-note");
            if (chainList && Array.isArray(CHAIN.guards)) {
                CHAIN.guards.forEach((g, i) => {
                    const li = mk(g.statute ? "li" : "li.house");
                    const ix = mk("span.ix"); ix.textContent = String(i + 1);
                    const gn = mk("span.gn"); gn.textContent = g.name;
                    if (g.id) {
                        const gid = mk("span.gid"); gid.textContent = g.id;
                        gn.appendChild(gid);
                    }
                    const gs = mk("span.gs"); gs.textContent = g.statute || "statute = None";
                    li.append(ix, gn, gs);
                    chainList.appendChild(li);
                });
                compose(chainNote, [
                    traceIn("chain", mk("b"), "count", String(CHAIN.count)),
                    " links, of which ",
                    traceIn("chain", mk("b"), "statutes", String(CHAIN.statutes)),
                    " cite a statute. Every one rules on every proposal and the most severe ruling wins, so a ",
                    "receipt names every clause an action violated rather than whichever guard happened to ",
                    "be checked first."
                ]);
            } else if (chainList) {
                chainList.outerHTML = `<p class="footnote">The guard chain was not serialised at build time.</p>`;
            }

            // World-keyed counters. No fallbacks: a missing field renders as a
            // dash rather than a plausible number, because the whole point of
            // these three columns is that they are measured.
            const WORLD_COLUMNS = [
                "instrument_dead_retries_world",
                "risk_block_actions_world",
                "customer_action_retries_world"
            ];
            const worldBody = document.querySelector("#world-table tbody");
            if (worldBody) {
                armOrder.forEach(arm => {
                    const row = document.createElement("tr");
                    if (arm === "vasool") { row.className = "is-vasool"; }
                    const name = document.createElement("td");
                    name.innerText = ARM_LABELS[arm] || arm;
                    row.appendChild(name);
                    WORLD_COLUMNS.forEach(col => {
                        const cell = document.createElement("td");
                        const value = arms[arm]?.[col];
                        if (typeof value !== "number") {
                            cell.innerText = "—";
                        } else {
                            // Taxonomy §2 permits one probe on an INSTRUMENT_DEAD
                            // row, so that column is not judged against zero.
                            if (col !== "instrument_dead_retries_world") {
                                cell.className = value === 0 ? "zero" : "nonzero";
                            }
                            trace(cell, `per_arm.${arm}.${col}`, nf(value));
                        }
                        row.appendChild(cell);
                    });
                    worldBody.appendChild(row);
                });
            }

            // The closure partition. Every cell is traced; a missing block
            // renders as dashes rather than a plausible split. No colour is
            // applied to `blocked` or `escalated` in the table: they are
            // neither good nor bad on their own, which is the point of
            // separating them from `recovered` in the first place.
            const CLOSURE_COLUMNS = [
                "episodes", "recovered", "blocked", "escalated", "exhausted", "awaiting"
            ];
            const BUCKETS = ["recovered", "blocked", "escalated", "exhausted", "awaiting"];
            const pbars = document.getElementById("pbars");
            const closureBody = document.querySelector("#closure-table tbody");
            armOrder.forEach(arm => {
                const c = arms[arm]?.closure;
                if (pbars && c && typeof c.episodes === "number" && c.episodes > 0) {
                    const name = mk(arm === "vasool" ? "div.pa.is-vasool" : "div.pa");
                    name.textContent = ARM_LABELS[arm] || arm;
                    const bar = mk("div.pb");
                    BUCKETS.forEach(b => {
                        if (typeof c[b] !== "number" || c[b] <= 0) return;
                        const seg = mk("i");
                        seg.style.width = `${(c[b] / c.episodes) * 100}%`;
                        seg.style.background = `var(--part-${b})`;
                        seg.title = `${ARM_LABELS[arm] || arm} · ${b} · ${nf(c[b])} of ${nf(c.episodes)} (${(c[b] / c.episodes * 100).toFixed(1)}%)`;
                        bar.appendChild(seg);
                    });
                    pbars.append(name, bar);
                }
                if (closureBody) {
                    const row = document.createElement("tr");
                    if (arm === "vasool") { row.className = "is-vasool"; }
                    const name = document.createElement("td");
                    name.innerText = ARM_LABELS[arm] || arm;
                    row.appendChild(name);
                    CLOSURE_COLUMNS.forEach(col => {
                        const cell = document.createElement("td");
                        const value = c?.[col];
                        if (typeof value !== "number") {
                            cell.innerText = "—";
                        } else {
                            trace(cell, `per_arm.${arm}.closure.${col}`, nf(value));
                        }
                        row.appendChild(cell);
                    });
                    closureBody.appendChild(row);
                }
            });

            const closureNote = document.getElementById("closure-note");
            const vc = arms.vasool?.closure;
            if (closureNote) {
                if (!vc || typeof vc.episodes !== "number") {
                    closureNote.innerHTML =
                        "The artifact carries no closure block, so this split cannot be stated.";
                } else {
                    const un = vc.episodes - vc.recovered;
                    const terminal = vc.blocked + vc.escalated + vc.exhausted;
                    const share = v => (v / un * 100).toFixed(1) + "%";
                    const naive = arms.naive_retry?.closure?.exhausted;
                    closureNote.innerHTML =
                        `<strong>Read Vasool's row against its recovery rate.</strong> ` +
                        `${nf(un)} episodes did not recover, and reporting that as one number ` +
                        `is what this table exists to stop. ${nf(vc.blocked)} of them ` +
                        `(${share(vc.blocked)}) are the guards declining to act &mdash; the ` +
                        `behaviour EVALUATION.md &sect;2a scans for, counted here as an outcome ` +
                        `rather than a shortfall. ${nf(vc.escalated)} (${share(vc.escalated)}) ` +
                        `went to a human. <strong>${nf(vc.awaiting)} (${share(vc.awaiting)}) ` +
                        `are still in flight at the horizon</strong> &mdash; right-censored, not ` +
                        `failed. That leaves ${nf(terminal)} terminal non-recoveries, not ${nf(un)}. ` +
                        `<strong>The comparison worth making is the exhausted column:</strong> ` +
                        `Vasool burns an attempt budget to nothing ${nf(vc.exhausted)} times` +
                        (typeof naive === "number"
                            ? `; <code>naive_retry</code> does it ${nf(naive)} times. That is the taxonomy, measured.`
                            : `; the artifact carries no <code>naive_retry</code> figure to set beside it.`);
                }
            }

            // 5. Exhibit C. §7's survival grid, or a plain statement that this
            // manifest has none. Only the exception carries colour.
            const sweeps = EVAL?.sweeps || {};
            const sweepNames = Object.keys(sweeps);
            const gridBox = document.getElementById("sweep-grid");
            if (!sweepNames.length) {
                document.getElementById("sweep-present").hidden = true;
                const absent = document.getElementById("sweep-absent");
                absent.hidden = false;
                const f6 = fal.F6_conclusions_are_model_artifacts;
                compose(document.getElementById("sweep-absent-body"), [
                    "This manifest carries no §7 grid, so F6 is not evaluated here, and the artifact says so ",
                    "in its own words: ",
                    f6?.detail ? trace(mk("code"), "falsification.F6_conclusions_are_model_artifacts.detail", f6.detail) : "&mdash;",
                    ". The grid takes the better part of a working day, so it is run once, at the end of a ",
                    "programme of changes, against the agent that programme finishes with. A grid measured ",
                    "against an earlier agent is not drawn beside this one, for the reason the holdout is not ",
                    "added to the hero."
                ]);
            } else if (gridBox) {
                const armsSeen = new Set();
                sweepNames.forEach(c => Object.keys(sweeps[c].arms || {}).forEach(a => armsSeen.add(a)));
                const flipCount = (arm) => sweepNames.filter(
                    c => sweeps[c].arms?.[arm]?.survives === false
                ).length;
                const order = [...armsSeen].sort(
                    (a, b) => flipCount(b) - flipCount(a) || a.localeCompare(b)
                );
                order.forEach(arm => {
                    const name = document.createElement("div");
                    name.className = "grid-arm"; name.textContent = arm;
                    const cells = document.createElement("div");
                    cells.className = "grid-cells";
                    let flips = 0;
                    sweepNames.forEach(cfg => {
                        const a = sweeps[cfg].arms?.[arm];
                        const bad = a && a.survives === false;
                        if (bad) flips++;
                        const c = document.createElement("div");
                        c.className = "grid-cell" + (bad ? " flip" : "");
                        c.title = `${arm} · ${cfg}\n${bad ? "fails to survive" : "survives"}`;
                        cells.appendChild(c);
                    });
                    const count = document.createElement("div");
                    count.className = "grid-count" + (flips ? " flip" : "");
                    trace(count, `sweeps.*.arms.${arm}.survives`, `${flips} / ${sweepNames.length}`);
                    gridBox.append(name, cells, count);
                });

                // An arm that fails everywhere is read against its own
                // reference: if that interval already includes zero, the sweep
                // did not move it -- the reference was never conclusive at the
                // grid's depth. Said from the artifact, for whichever arm it is.
                const note = document.getElementById("sweep-note");
                const always = order.filter(a => flipCount(a) === sweepNames.length);
                const parts = [
                    `${words(order.length - order.filter(a => flipCount(a) > 0).length)} of the ${words(order.length)} `,
                    `comparisons survive every one of the ${nf(sweepNames.length)} configurations. `
                ];
                always.forEach(arm => {
                    const ref = EVAL?.sweep_reference?.[arm]?.recovery_rate;
                    if (ref && ref.excludes_zero === false) {
                        parts.push(`<strong>${arm} fails in all ${nf(sweepNames.length)}, and that is not a parameter effect.</strong> `,
                            `Its reference interval at ${nf(ref.n_seeds)} seeds is `,
                            trace(mk("b"), `sweep_reference.${arm}.recovery_rate`,
                                  `[${ref.low.toFixed(5)}, ${ref.high >= 0 ? "+" : ""}${ref.high.toFixed(5)}]`),
                            `, which already includes zero &mdash; so <code>survives()</code> fails because the `,
                            `reference was never conclusive at this depth, not because any sweep moved it. `,
                            `Registered as a limit in <code>EVALUATION.md</code> &sect;10 rather than argued away, `,
                            `and it pushes F6 <em>toward</em> firing, which is the conservative direction. `);
                    }
                });
                compose(note, parts);
            }

            // 6. Exhibit D. §9's seven criteria.
            const F_META = [
                ["F1", "F1_taxonomy_adds_nothing", "The taxonomy adds nothing",
                 "fires iff the paired interval vs retry_plus_contact includes zero"],
                ["F2", "F2_flagship_claim_inert", "The flagship card_expired claim is inert",
                 "fires iff A3 is inert on recovery rate AND on attempts consumed"],
                ["F3", "F3_salary_timing_is_noise", "Salary-aware timing is noise",
                 "fires iff A2's paired interval includes zero"],
                ["F4", "F4_guards_unreliable", "The guards are unreliable",
                 "fires iff pass^100 on the §2a predicate is below 1.0"],
                ["F5", "F5_compliance_unaffordable", "Compliance is unaffordable",
                 "fires iff ungated beats gated by more than 20 absolute points"],
                ["F6", "F6_conclusions_are_model_artifacts", "The conclusions are model artifacts",
                 "fires iff 5 or more of 8 comparisons flip across §7's grid"],
                ["F7", "F7_determinism_fails", "Determinism fails",
                 "fires iff two runs of one seed produce different ledgers"]
            ];
            const fb = document.getElementById("fboard");
            if (fb) {
                F_META.forEach(([id, key, name, thr]) => {
                    const v = fal[key];
                    const row = document.createElement("div");
                    row.className = "frow";
                    let icon, colour, text;
                    if (!v) {
                        icon = "—"; colour = "var(--viz-muted)"; text = "not in artifact";
                    } else if (v.fired === true) {
                        icon = "✗"; colour = "var(--status-critical)"; text = "FIRED";
                    } else if (v.fired === false) {
                        icon = "✓"; colour = "var(--status-good)"; text = "did not fire";
                    } else {
                        icon = "○"; colour = "var(--viz-muted)"; text = "not evaluated here";
                        row.className = "frow idle";
                    }
                    let measured = "";
                    if (key.startsWith("F1") && v?.interval)
                        measured = `${(v.interval.point * 100).toFixed(2)}pp, ${v.direction}`;
                    if (key.startsWith("F2") && v?.direction)
                        measured = `recovery rate: ${v.direction}`;
                    if (key.startsWith("F3") && v?.interval)
                        measured = `${v.interval.point >= 0 ? "+" : ""}${(v.interval.point * 100).toFixed(2)}pp`;
                    if (key.startsWith("F5") && typeof v?.gap_pp === "number")
                        measured = `${v.gap_pp.toFixed(2)}pp of ${v.threshold_pp}`;
                    if (key.startsWith("F4") && v?.pass_k)
                        measured = `pass^100 = ${v.pass_k["100"] ?? "—"}`;
                    if (key.startsWith("F6") && typeof v?.threshold === "number")
                        measured = `threshold ${v.threshold} of ${v.denominator?.length ?? "?"}`;
                    if (key.startsWith("F7") && Array.isArray(v?.seeds_checked))
                        measured = `ledgers identical on seeds ${v.seeds_checked.join(", ")}`;

                    // F1 did not fire, and that is the misleading case: the
                    // interval excludes zero on the baseline's side. Flag it.
                    const misleading = key.startsWith("F1") && v?.direction === "vasool behind";
                    if (misleading) row.className = "frow warn";

                    row.innerHTML =
                        `<div class="fid" style="color:${colour}">${id}</div>` +
                        `<div><span class="fname">${name}</span>` +
                        `<span class="fthr">${thr}</span>` +
                        (misleading
                            ? `<span class="fwarn">` +
                              `⚠ Did not fire &mdash; but the interval excludes zero on the wrong side. ` +
                              `A worse result than F1 firing, and not covered by the registered wording.</span>`
                            : "") +
                        `</div>` +
                        `<div class="fverdict" style="color:${colour}"></div>`;
                    const verdict = row.querySelector(".fverdict");
                    trace(verdict, `falsification.${key}.fired`, `${icon} ${text}`);
                    if (measured) {
                        const m = mk("span");
                        m.style.color = "var(--dim)";
                        m.style.marginTop = "3px";
                        m.textContent = measured;
                        verdict.insertBefore(m, verdict.querySelector(".prov-path"));
                    }
                    fb.appendChild(row);
                });
                const fired = F_META.filter(([, key]) => fal[key]?.fired === true).map(([id]) => id);
                const idle = F_META.filter(([, key]) => fal[key] && fal[key].fired !== true && fal[key].fired !== false).map(([id]) => id);
                compose(document.getElementById("f-summary"), [
                    fired.length
                        ? `<strong>${fired.join(", ")} fired.</strong>`
                        : `None of the evaluated criteria fired${idle.length ? ` &mdash; ${idle.join(", ")} could not be evaluated from this manifest, and says so` : ""}.`
                ]);
            }

            // 7. Exhibit E. §4.5 — the rules-vs-LLM comparison, from its own artifact.
            const llmBody = document.querySelector("#llm-table tbody");
            const llmNote = document.getElementById("llm-note");
            const llmTiles = document.getElementById("llm-tiles");
            const ov = SHADOW.overall;

            if (llmBody && ov) {
                const pctOf = (x) => (typeof x === "number" ? (x * 100).toFixed(1) + "%" : "—");
                [
                    ["overall.rules_accuracy", pctOf(ov.rules_accuracy), "rules classifier — by construction, not measured"],
                    ["overall.llm_accuracy", pctOf(ov.llm_accuracy), "LLM picked the right failure class"],
                    ["overall.intervention_agreement", pctOf(ov.intervention_agreement), "LLM picked the action §4 names for the row"],
                    ["covered_cells", `${SHADOW.covered_cells} / ${SHADOW.total_cells}`,
                     SHADOW.covered_cells === SHADOW.total_cells
                       ? `cells, every one asked ${SHADOW.repeats}× — the free tier caps depth, not coverage`
                       : "cells recorded — free-tier quota, not a design choice"]
                ].forEach(([path, v, l]) => {
                    const d = document.createElement("div");
                    d.className = "tile";
                    d.innerHTML = `<div class="tv"></div><div class="tl">${l}</div>`;
                    traceIn("shadow", d.querySelector(".tv"), path, v);
                    llmTiles.appendChild(d);
                });

                (SHADOW.by_cell || []).forEach(c => {
                    const tr = document.createElement("tr");
                    const recorded = c.repeats > 0 && c.absent < c.repeats;
                    const top = (c.llm_classes && c.llm_classes.length)
                        ? c.llm_classes.map(([k, n]) => `${k}×${n}`).join(", ")
                        : "—";
                    const acc = recorded ? (c.llm_accuracy * 100).toFixed(0) + "%" : "—";
                    const con = recorded && typeof c.llm_consistency === "number"
                        ? (c.llm_consistency * 100).toFixed(0) + "%" : "—";
                    // A stable wrong answer is the finding. Accuracy alone hides it,
                    // consistency alone flatters it; they are shown together.
                    const damning = recorded && c.llm_accuracy === 0 && c.llm_consistency === 1;
                    tr.innerHTML =
                        `<td>${c.error_reason} / ${c.error_source}</td>` +
                        `<td>${c.truth}</td>` +
                        `<td class="zero">${c.rules}</td>` +
                        `<td class="${recorded ? (c.llm_accuracy === 1 ? "zero" : "nonzero") : ""}">${top}</td>` +
                        `<td class="${recorded && c.llm_accuracy < 1 ? "nonzero" : ""}">${acc}</td>` +
                        `<td${damning ? ' class="nonzero"' : ""}>${con}</td>` +
                        `<td>${nf(c.episodes)}</td>`;
                    llmBody.appendChild(tr);
                });

            const llmScope = document.getElementById("llm-scope");
            if (llmScope && typeof SHADOW.rail_scope === "string") {
                compose(llmScope, [
                    " The comparison covers the ",
                    traceIn("shadow", mk("b"), "rail_scope", `${SHADOW.rail_scope} rail`),
                    " only. Every recording behind it is keyed to a cell and the free tier ",
                    "allows twenty requests a day, so no UPI Autopay reason has ever been put ",
                    "to the model &mdash; and a dash is not reported here as coverage."
                ]);
            }

                const worst = (SHADOW.by_cell || [])
                    .filter(c => c.absent < c.repeats && c.llm_accuracy === 0 && c.llm_consistency === 1)
                    .sort((a, b) => b.episodes - a.episodes)[0];
                llmNote.innerHTML = worst
                    ? `<strong>Read the last two columns together.</strong> On ` +
                      `<code>${worst.error_reason} / ${worst.error_source}</code> — the largest ` +
                      `recorded cell at ${nf(worst.episodes)} episodes — the ` +
                      `model answered <strong>${worst.llm_classes[0][0]}</strong> every single time, ` +
                      `for a consistency of 100% and an accuracy of 0%. A stable wrong answer is worse ` +
                      `than an unstable one: it is confidently, reproducibly incorrect about the most ` +
                      `common failure on the platform, and either column alone would have hidden it. ` +
                      `That is the measurement behind keeping this component in shadow.`
                    : SHADOW.complete
                      ? `Every cell in the corpus is here. The dashes are the consistency ` +
                        `column: at k=1 one answer per cell measures whether it was right, ` +
                        `never whether the model would repeat it, so stability is reported ` +
                        `as — rather than as the 1.000 the arithmetic would produce.`
                      : `Every recorded cell is shown. A dash means the cell has no recording ` +
                        `and contributes to no rate.`;
            } else if (llmNote) {
                llmNote.textContent =
                    "No comparison artifact on disk — run `make shadow` to build one.";
            }

            // 8. Exhibit G. The adversary, from out/adversary/redteam.json.
            const rtBody = document.querySelector("#rt-table tbody");
            const rtTiles = document.getElementById("rt-tiles");
            const rtNote = document.getElementById("rt-note");
            if (rtBody && Array.isArray(RT.results)) {
                [
                    ["survived", `${RT.survived} / ${RT.attacks}`, "attacks survived the registered criterion"],
                    ["failed", String(RT.failed), "open failures, each named and reproducible"],
                    ["as_registered", RT.as_registered ? "yes" : "NO", "every attack judged against the criterion as registered"]
                ].forEach(([path, v, l]) => {
                    const d = document.createElement("div");
                    d.className = "tile";
                    d.innerHTML = `<div class="tv"></div><div class="tl">${l}</div>`;
                    traceIn("redteam", d.querySelector(".tv"), path, v);
                    rtTiles.appendChild(d);
                });
                // The fourth tile said "13" in type for a week after the chain
                // became fifteen. It is the registry's count now.
                if (typeof CHAIN.count === "number") {
                    const d = document.createElement("div");
                    d.className = "tile";
                    d.innerHTML = `<div class="tv"></div><div class="tl">guards, all evaluated then resolved by severity</div>`;
                    traceIn("chain", d.querySelector(".tv"), "count", String(CHAIN.count));
                    rtTiles.appendChild(d);
                }

                // Failures first: they are the informative half.
                const ordered = RT.results.slice().sort(
                    (a, b) => (a.survived === b.survived) ? a.id.localeCompare(b.id)
                                                          : (a.survived ? 1 : -1)
                );
                ordered.forEach(r => {
                    const broke = (r.clauses || []).filter(c => !c.held);
                    const why = broke.length
                        ? broke.map(c => c.detail).join("; ")
                        : `all ${(r.clauses || []).length} clauses held`;
                    const tr = document.createElement("tr");
                    // No row-level tint: `is-vasool` is the green "this is ours"
                    // class, and painting a failure green is exactly the wrong
                    // signal. The verdict cell carries the colour.
                    if (!r.survived) tr.className = "open-row";
                    tr.innerHTML =
                        `<td><b>${r.id}</b> &middot; ${r.title}</td>` +
                        `<td class="${r.survived ? "verdict-held" : "verdict-open"}">` +
                        `${r.survived ? "✓ survived" : "✗ open"}</td>` +
                        `<td style="white-space: normal; text-align: left; max-width: 420px;">${why}</td>` +
                        `<td>${r.receipts}</td>` +
                        `<td style="font-size: 11px; color: var(--dimmer);">${(r.ledger_sha256 || "").slice(0, 12)}</td>`;
                    rtBody.appendChild(tr);
                });

                // This paragraph counted the open attacks in its own prose and
                // went stale the day two of them closed. Both the count and the
                // names are the artifact's now.
                const open = RT.results.filter(r => !r.survived).map(r => r.id);
                const asExpected = RT.results.filter(r => !r.survived && r.expectation === "fails").length;
                compose(rtNote, [
                    `${words(open.length).replace(/^./, c => c.toUpperCase())} ${open.length === 1 ? "is" : "are"} open and named`,
                    open.length ? ` &mdash; ${open.join(", ")}` : "",
                    open.length && asExpected === open.length
                        ? `. They are not bugs awaiting a fix in the last commit &mdash; each is a limit with a ` +
                          `registered expectation of failing, so a known failure keeps the suite green and a ` +
                          `<em>fixed</em> one turns it red. A clean sheet here would be evidence the attacks are too weak.`
                        : `. An attack that fails without a registered expectation of failing turns the suite red.`
                ]);
            }

            // 9. Exhibits H and I. The ledger, verified in this browser.
            // The verifier opens having verified: the first receipt, checked on
            // load, so the page's first claim about its ledger is a result.
            if (sampleLedger.length > 0 && sampleLedger[0].receipt_id) {
                document.getElementById("verify-input").value = sampleLedger[0].receipt_id;
                runVerification();
            }

            const explorerList = document.getElementById("explorer-list");
            const explorerConsole = document.getElementById("explorer-console");
            const OUTCOME_CLASS = { executed: "oc-executed", recovered: "oc-recovered", blocked: "oc-blocked", escalated: "oc-escalated" };
            const showReceipt = (record, item) => {
                explorerList.querySelectorAll(".explorer-item").forEach(el => el.classList.remove("active"));
                if (item) item.classList.add("active");
                explorerConsole.innerHTML =
                    `<span class="xh">[RECEIPT: ${escapeHtml(record.receipt_id)}]</span>` +
                    `<span class="xm">sha256 ${escapeHtml(record.hash || "")}\nprev   ${escapeHtml(record.prev_hash || "")}</span>` +
                    `<span class="xb">${escapeHtml(record.canonical_payload || "No canonical payload available.")}</span>` +
                    `<div class="xact"><button class="btn p" type="button" id="xverify">Verify in Exhibit H</button></div>`;
                document.getElementById("xverify").onclick = () => {
                    document.getElementById("verify-input").value = record.receipt_id;
                    document.getElementById("exhibit-h").scrollIntoView({ behavior: "smooth", block: "start" });
                    runVerification();
                };
            };

            if (sampleLedger.length > 0) {
                const summary = mk("div.explorer-summary");
                summary.innerHTML = `verifying ${nf(sampleLedger.length)} receipts…`;
                explorerList.appendChild(summary);
                const items = sampleLedger.map((record, index) => {
                    const item = mk("button.explorer-item");
                    item.type = "button";
                    const when = (record.at || "").replace("T", " ").slice(0, 16);
                    const oc = OUTCOME_CLASS[record.outcome] || "oc-other";
                    item.innerHTML =
                        `<span class="dotp"></span>` +
                        `<div class="r1"><span>${String(index + 1).padStart(2, "0")}</span>` +
                        `<span>${escapeHtml(record.receipt_id.slice(0, 13))}…</span>` +
                        `<span class="oc ${oc}">${escapeHtml(record.outcome || "")}</span></div>` +
                        `<div class="r2">${escapeHtml(record.entity_id || "")} · ${escapeHtml(when)}</div>`;
                    item.addEventListener("click", () => showReceipt(record, item));
                    explorerList.appendChild(item);
                    return item;
                });
                showReceipt(sampleLedger[0], items[0]);

                // Every digest recomputed, every link walked back to genesis.
                let digests = 0, links = 0, unavailable = false;
                for (let i = 0; i < sampleLedger.length; i++) {
                    const r = sampleLedger[i];
                    const got = await hashString(r.canonical_payload || "");
                    if (got === "insecure-env" || got === "hash-error") { unavailable = true; break; }
                    const sealed = got === r.hash;
                    const linked = i === 0 ? /^0+$/.test(r.prev_hash || "") : r.prev_hash === sampleLedger[i - 1].hash;
                    if (sealed) digests++;
                    if (linked) links++;
                    items[i].classList.add(sealed && linked ? "ok" : "bad");
                    items[i].title = sealed && linked
                        ? "digest recomputed in this browser; links to the receipt before it"
                        : (!sealed ? "digest does not match its payload" : "does not link to the receipt before it");
                }
                summary.innerHTML = unavailable
                    ? `Web Crypto is unavailable here, so nothing was verified. Open the page over HTTPS.`
                    : `<b>${digests} of ${sampleLedger.length}</b> digests recomputed here · ` +
                      `<b>${links} of ${sampleLedger.length}</b> links intact, back to genesis`;
                const cap = document.getElementById("explorer-caption");
                if (cap && typeof EVAL?.determinism?.sample_seed === "number") {
                    cap.insertAdjacentHTML("afterbegin", "");
                    compose(cap, [
                        "The first ",
                        trace(mk("b"), "determinism.sample_receipts", nf(sampleLedger.length)),
                        " receipts of seed ",
                        trace(mk("b"), "determinism.sample_seed", String(EVAL.determinism.sample_seed)),
                        "'s ledger, from genesis, shown as the <em>exact byte string</em> each hash was computed ",
                        "over &mdash; guard decisions, obligations, statute citations and all. Nothing here is ",
                        "pretty-printed, because reformatting would change the bytes and break the hash. Every ",
                        "digest and every link back to genesis was recomputed in this browser when the page loaded."
                    ]);
                }
            } else {
                explorerConsole.innerHTML = `&gt; Ledger is empty or missing from evaluation.json`;
            }

            // 10. The spine: one mark per exhibit, the current one lit, click to
            // jump. It used to render five SHA-256 prefixes, two of them hashes of
            // hardcoded strings -- content fingerprints on a page whose claim is
            // that its figures are real. Now it is an index and nothing more.
            const spine = document.getElementById("spine");
            if (spine) {
                const exhibits = [...document.querySelectorAll(".exhibit[id^='exhibit-']")];
                const marks = new Map();

                for (const ex of exhibits) {
                    const letter = ex.id.split("-")[1].toUpperCase();
                    const titleEl = ex.querySelector(".ex-name");
                    const full = titleEl ? titleEl.textContent.trim() : `Exhibit ${letter}`;

                    const mark = document.createElement("a");
                    mark.className = "spine-mark";
                    mark.href = `#${ex.id}`;
                    mark.textContent = letter;
                    mark.setAttribute("data-label", full);
                    mark.setAttribute("aria-label", `Jump to Exhibit ${letter}, ${full}`);
                    spine.appendChild(mark);
                    marks.set(ex.id, mark);
                }

                const progress = document.createElement("div");
                progress.className = "spine-progress";
                progress.innerHTML = '<div class="spine-progress-fill"></div>';
                spine.appendChild(progress);
                const fill = progress.firstElementChild;

                // Highlight whichever exhibit owns the upper third of the
                // viewport, which is where a reader is actually looking. Sticky:
                // in the gaps between exhibits no section owns the band, and
                // clearing the mark there makes the spine flicker off.
                const seen = new Set();
                let lastActive = exhibits.length ? exhibits[0].id : null;
                const observer = new IntersectionObserver((entries) => {
                    for (const e of entries) {
                        if (e.isIntersecting) seen.add(e.target.id);
                        else seen.delete(e.target.id);
                    }
                    let active = null;
                    for (const ex of exhibits) if (seen.has(ex.id)) { active = ex.id; break; }
                    if (active) lastActive = active;
                    for (const [id, mark] of marks)
                        mark.classList.toggle("is-here", id === lastActive);
                }, { rootMargin: "-12% 0px -68% 0px", threshold: 0 });
                exhibits.forEach((ex) => observer.observe(ex));
                if (lastActive) marks.get(lastActive)?.classList.add("is-here");

                const setProgress = () => {
                    const max = document.documentElement.scrollHeight - innerHeight;
                    fill.style.height = max > 0
                        ? `${Math.min(100, Math.max(0, (scrollY / max) * 100))}%` : "0%";
                };
                addEventListener("scroll", setProgress, { passive: true });
                addEventListener("resize", setProgress);
                setProgress();
            }

            // The close carries manifest keys like everything else -- a footer
            // is exactly where a hand-typed "1,000 seeds" would survive a
            // re-run and go unnoticed.
            const footSeeds = document.getElementById("foot-seeds");
            const footArms = document.getElementById("foot-arms");
            if (footSeeds && typeof EVAL.per_arm?.vasool?.seeds === "number") {
                trace(footSeeds, "per_arm.vasool.seeds", nf(EVAL.per_arm.vasool.seeds));
            }
            if (footArms && EVAL.per_arm) {
                trace(footArms, "per_arm (count)", String(Object.keys(EVAL.per_arm).length));
            }
        });

        // Exhibit H. Recomputes the digest from the sealed bytes; with `forge`,
        // from a copy with one byte changed, to show what an edit costs.
        async function runVerification(forge) {
            const consoleBox = document.getElementById("verifier-console");
            const hexBox = document.getElementById("verifier-hex");
            const inputId = document.getElementById("verify-input").value.trim();
            const safeInputId = escapeHtml(inputId);
            hexBox.innerHTML = "";

            consoleBox.innerHTML = `&gt; fetching ledger record ${safeInputId}...\n`;

            if (!inputId) {
                consoleBox.innerHTML += `<span class="console-error">&gt; ERROR: No receipt ID provided.</span>`;
                return;
            }

            const record = sampleLedger.find(r => r.receipt_id === inputId);

            if (!record) {
                consoleBox.innerHTML += `<span class="console-error">&gt; ERROR: Receipt ${safeInputId} not found in EVAL.</span>\n`;
                consoleBox.innerHTML += `<span class="console-error">&gt; NOTE: the manifest carries the head of one seed's ledger. 'make eval' recomputes every ledger behind it.</span>`;
                return;
            }
            if (!record.canonical_payload) {
                consoleBox.innerHTML += `<span class="console-error">&gt; FATAL: Record is missing 'canonical_payload'. Please re-run the ledger pipeline.</span>`;
                return;
            }

            let payloadStr = record.canonical_payload;
            if (forge) {
                // The first digit after "amount_recovered_paise": changes, which
                // is the forgery that would matter: money the ledger did not see.
                const at = payloadStr.indexOf('"amount_recovered_paise":') + '"amount_recovered_paise":'.length;
                const ch = payloadStr[at];
                const swapped = /[0-8]/.test(ch) ? String(Number(ch) + 1) : "1";
                payloadStr = payloadStr.slice(0, at) + swapped + payloadStr.slice(at + 1);
                consoleBox.innerHTML += `&gt; FORGED COPY: amount_recovered_paise's first digit ${escapeHtml(ch)} → ${swapped}\n`;
            } else {
                consoleBox.innerHTML += `&gt; Found record. Generating SHA-256 digest via Web Crypto API...\n`;
            }
            consoleBox.innerHTML += `&gt; payload: ${escapeHtml(payloadStr.substring(0, 60))}...\n`;

            try {
                const hashHex = await hashString(payloadStr);

                if (hashHex === "insecure-env") {
                    consoleBox.innerHTML += `\n<span class="console-error">&gt; ERROR: Web Crypto API is unavailable. Are you opening this file locally (file://) in Safari? Use Chrome, or host it on an HTTPS server (like GitHub Pages) to run live cryptographic verification.</span>`;
                    return;
                }

                const expectedHash = record.hash || "UNKNOWN";
                const row = (label, hex, against) => {
                    const groups = [];
                    for (let i = 0; i < hex.length; i += 8) {
                        const g = hex.slice(i, i + 8).split("").map((c, j) => {
                            const cls = against === undefined ? "" : (c === against[i + j] ? "on" : "off");
                            return `<span class="${cls}">${c}</span>`;
                        }).join("");
                        groups.push(`<span class="grp">${g}</span>`);
                    }
                    return `<div class="hexrow"><div class="lb">${label}</div><div class="hexline">${groups.join("")}</div></div>`;
                };
                hexBox.innerHTML = row("sealed in the ledger", expectedHash) +
                                   row(forge ? "recomputed from the forged copy" : "recomputed in this browser", hashHex, expectedHash);

                if (hashHex === expectedHash) {
                    consoleBox.innerHTML += `\n<span class="console-success">&gt; VERIFIED: Digest matches ledger. Cryptographic chain is intact.</span>`;
                } else if (forge) {
                    const same = hashHex.split("").filter((c, i) => c === expectedHash[i]).length;
                    consoleBox.innerHTML += `\n<span class="console-error">&gt; BROKEN: one byte changed; ${64 - same} of 64 hex digits of the digest changed with it. The next receipt's prev_hash no longer points here.</span>`;
                } else {
                    consoleBox.innerHTML += `\n<span class="console-error">&gt; FATAL: Hash mismatch! Ledger integrity compromised or serialization algorithm differs.</span>`;
                }
            } catch (error) {
                consoleBox.innerHTML += `\n<span class="console-error">&gt; ERROR executing Web Crypto API: ${escapeHtml(error.message)}</span>`;
            }
        }
    </script>
</body>
</html>
